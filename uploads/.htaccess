# Prevent script execution inside uploads directory
Options -Indexes -ExecCGI
<FilesMatch "\.(?i:php|php[0-9]|phtml|phar|pl|py|cgi|sh|exe|bat|cmd|asp|aspx|jsp|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
